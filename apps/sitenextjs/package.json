{
  "name": "custom-sites",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3030",
    "build": "next build --webpack",
    "build:static": "node scripts/prepare-deploy-target.js static && next build --webpack && node scripts/prepare-deploy-target.js node",
    "build:node": "node scripts/prepare-deploy-target.js node && next build --webpack",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@geniebuild": "workspace:*",
    "@schema/core": "workspace:*",
    "next": "^16.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "axios": "^1.9.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.5.3",
    "tailwindcss": "^3.4.11",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-config-next": "^16.0.3"
  }
}
