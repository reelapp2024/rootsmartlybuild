{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ui/blocks": [
        "../geniebuild/src/ui-blocks/index.tsx"
      ],
      "@geniebuild/*": [
        "../geniebuild/*"
      ],
      "@schema/core": [
        "../schema/src"
      ],
      "@schema/core/*": [
        "../schema/src/*"
      ],
      "@shared/siteSectionOrder": [
        "../../backend/additional/siteSectionOrder.mjs"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
