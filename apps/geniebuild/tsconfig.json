{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@ui/blocks": [
        "./src/ui-blocks/index.tsx"
      ],
      "@schema/core": [
        "../schema/src"
      ],
      "@schema/core/*": [
        "../schema/src/*"
      ],
      "@shared/siteSectionOrder": [
        "../../backend/additional/siteSectionOrder.mjs"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}