<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="title" content="Professional News Website">
    <meta name="description" content="Stay updated with the latest news presented in a simple and professional format.">
    <meta name="keywords" content="News, Breaking News, Headlines, Professional News">
    <title>NewsHub</title>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f9f9f9;
        }
        .navbar {
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            background-color: #343a40;
        }
        .navbar-brand {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: white;
        }
        .navbar-nav .nav-link {
            color: white;
            font-weight: 500;
        }
        .navbar-nav .nav-link:hover {
            color: #007bff;
        }
        .hero-banner {
            background: url('https://media.istockphoto.com/id/1248300211/photo/men-reading-news-on-a-laptop-screen-mockup-website-newspaper-and-portal-on-internet.jpg?s=1024x1024&w=is&k=20&c=4TlMSCGa0wX3hETU2ZBFcYhQAkCAq1kpFVs0TkNqhe8=') no-repeat center center/cover;
            height: 300px;
            color: black;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
        .hero-banner h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
        }
        .news-section {
            padding: 20px;
        }
        .news-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 600;
            color: #343a40;
            margin-bottom: 10px;
        }
        .news-content {
            font-size: 1rem;
            line-height: 1.8;
            color: #555;
        }
        footer {
            background-color: #343a40;
            color: white;
            padding: 20px 0;
        }
        footer a {
            color: #007bff;
        }
        footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">NewsHub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="#">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">About Us</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Contact Us</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Refer & Earn</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#"><img src="facebook-icon.png" alt="Facebook" style="width: 20px;"></a></li>
                    <li class="nav-item"><a class="nav-link" href="#"><img src="instagram-icon.png" alt="Instagram" style="width: 20px;"></a></li>
                    <li class="nav-item"><a class="nav-link" href="#"><img src="youtube-icon.png" alt="YouTube" style="width: 20px;"></a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Banner -->
    <div class="hero-banner">
        <h1>Breaking News & Headlines</h1>
    </div>

    <!-- News Section -->
    <div class="container news-section">
        <h2 class="mb-4 text-center">Top Stories</h2>
        <article>
            <h3 class="news-title">Headline 1</h3>
            <p class="news-content">
                This is a brief description of the news article. It provides an overview of the topic discussed, ensuring readers stay informed with credible information.
            </p>
        </article>
        <hr>
        <article>
            <h3 class="news-title">Headline 2</h3>
            <p class="news-content">
                Another key story to keep you updated. This section dives into important details about the latest developments in the world.
            </p>
        </article>
        <hr>
        <article>
            <h3 class="news-title">Headline 3</h3>
            <p class="news-content">
                Explore insights and perspectives about the current events that matter. Stay connected with in-depth analysis and updates.
            </p>
        </article>

        <% data.forEach(news => { %>
            <article>
                <h3 class="news-title"><%= news.title %></h3>
                <p class="news-content"><%= news.description || 'No description available.' %></p>
                <a href="<%= news.shareUrl %>" target="_blank" class="btn btn-primary">Read More</a>
            </article>
        <% }) %>

        <!-- Pagination -->
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item"><a class="page-link" href="#">Previous</a></li>
                <li class="page-item"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#">Next</a></li>
            </ul>
        </nav>
    </div>

    <!-- Footer -->
    <footer class="text-center">
        <p>&copy; 2024 NewsHub. <a href="#">Privacy Policy</a> | <a href="#">Terms of Service</a></p>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
