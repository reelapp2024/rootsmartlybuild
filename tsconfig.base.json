{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@schema/*": [
        "packages/schema/src/*"
      ],
      "@ui/*": [
        "packages/ui/src/*"
      ],
      "@shared/*": [
        "packages/shared/src/*"
      ]
    },
    "skipLibCheck": true
  }
}
